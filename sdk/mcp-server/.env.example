# PayRaider plugin (MCP server) configuration.

# URL of the PayRaider backend the plugin reads from. Required when hosting.
PAYRAIDER_BASE_URL=http://host.docker.internal:8080

# mainnet | testnet. Only used to pick a default backend URL when
# PAYRAIDER_BASE_URL is unset.
PAYRAIDER_NETWORK=testnet

# Optional. Without a key the backend's free anonymous tier applies, which is
# enough for the pre-payment check and the other public read endpoints.
PAYRAIDER_API_KEY=

# HTTP transport only.
# Bearer token callers must send. Set this for any deployment reachable from
# the internet; generate one with: openssl rand -hex 32
PAYRAIDER_MCP_AUTH_TOKEN=
# Comma-separated browser origins allowed to call the endpoint.
PAYRAIDER_MCP_ALLOWED_ORIGINS=
HOST=127.0.0.1
PORT=3333
