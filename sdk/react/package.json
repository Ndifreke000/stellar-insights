{
  "name": "@stellar-insights/react",
  "version": "0.1.0",
  "description": "React hooks and components for the Stellar Insights API, built on @stellar-insights/sdk",
  "homepage": "https://github.com/Ndifreke000/stellar-insights/tree/main/sdk/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ndifreke000/stellar-insights.git",
    "directory": "sdk/react"
  },
  "bugs": {
    "url": "https://github.com/Ndifreke000/stellar-insights/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "stellar",
    "react",
    "hooks",
    "components",
    "payments",
    "analytics"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@stellar-insights/sdk": "^1.0.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@stellar-insights/sdk": "file:../typescript",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "8.5.1",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  }
}
