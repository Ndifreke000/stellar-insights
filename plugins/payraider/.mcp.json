{
  "mcpServers": {
    "payraider": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/server.mjs", "--stdio"],
      "env": {
        "PAYRAIDER_BASE_URL": "${PAYRAIDER_BASE_URL:-}",
        "PAYRAIDER_NETWORK": "${PAYRAIDER_NETWORK:-testnet}",
        "PAYRAIDER_API_KEY": "${PAYRAIDER_API_KEY:-}"
      }
    }
  }
}
