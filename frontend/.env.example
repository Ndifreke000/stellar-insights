# Backend API (required — the app throws at startup without this)
# Local dev: http://localhost:8080
# Testnet/staging: point at the deployed backend instance
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# App
NEXT_PUBLIC_APP_VERSION=

# Internal monitoring route access control (server-side only, never NEXT_PUBLIC_)
# Set to any strong random string. Requests to /[locale]/internal/monitoring must
# carry this value in the X-Internal-Token header or internal_token cookie.
# If unset in development the gate is skipped; in production it blocks all access.
INTERNAL_SECRET=
